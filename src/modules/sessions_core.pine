// @module modules/sessions_core
// @requires core/base, core/time, core/theme, core/budget
// @description Session tracker: membership, high/low/open per session instance, most recent completed range, drawing (rules/sessions.md).

// update() results
SES_NONE = 0
SES_STARTED = 1
SES_UPDATED = 2
SES_COMPLETED = 3

// One session definition plus its running state. Times are Chicago minutes of the day.
// hi/lo/op: the current (or just finished) instance. last*: the most recent COMPLETED
// instance (D15.4: only the most recent one is kept; it is replaced each day).
type SessionTracker
    string key
    string tag
    int startMin
    int endMin
    bool active = false
    int day
    float hi
    float lo
    float op
    int startT
    int lastClose
    bool partial = false
    float lastHi
    float lastLo
    float lastOp
    int lastKnownAt
    int lastDay
    bool lastPartial = false
    line hiLn
    line loLn
    label tagLb
    box shadeBx

ses_new(string key, string tag, int startMin, int endMin) =>
    SessionTracker.new(key = key, tag = tag, startMin = startMin, endMin = endMin)

// Session inputs are typed as HHMM, e.g. 1900 -> 19:00 -> 1140 minutes.
ses_hhmmToMin(int hhmm) =>
    int(math.floor(hhmm / 100.0)) * 60 + hhmm % 100

// R1 membership of one candle.
method contains(SessionTracker this, Candle c) =>
    tm_inWindow(c, this.startMin, this.endMin)

method complete(SessionTracker this) =>
    this.active := false
    this.lastHi := this.hi
    this.lastLo := this.lo
    this.lastOp := this.op
    this.lastKnownAt := this.lastClose
    this.lastDay := this.day
    this.lastPartial := this.partial

// Feed one CLOSED candle. An instance starts at the first candle inside the window and
// completes on the candle that closes at the window end, or, if that candle is missing
// (holiday, early close, data gap), on the first candle after it. The completed range
// becomes known at the close of its last candle inside the window (core C5 uses this).
method update(SessionTracker this, Candle c) =>
    int status = SES_NONE
    bool inWin = this.contains(c)
    int d = tm_tradingDay(c.t)
    if this.active and (not inWin or d != this.day)
        this.complete()
        status := SES_COMPLETED
    if inWin
        if not this.active
            this.active := true
            this.day := d
            this.hi := c.h
            this.lo := c.l
            this.op := c.o
            this.startT := c.t
            this.partial := tm_minuteOfDay(c.t) != this.startMin
            status := SES_STARTED
        else
            this.hi := math.max(this.hi, c.h)
            this.lo := math.min(this.lo, c.l)
            status := SES_UPDATED
        this.lastClose := c.tc
        if tm_minuteOfDay(c.tc) == this.endMin % 1440
            this.complete()
            status := SES_COMPLETED
    status

// DESIGN.md §6.6: faint dotted outline of the session's high/low (tier 3), a tiny tag
// at its start, optional 96 % shade. Called after update() on closed chart candles.
method draw(SessionTracker this, int status, DrawPool pool, bool shade) =>
    color lineCol = color.new(THEME.ink2, 60)
    if status == SES_STARTED
        this.hiLn := pool.addLine(line.new(this.startT, this.hi, this.lastClose, this.hi, xloc = xloc.bar_time, color = lineCol, style = line.style_dotted, width = 1))
        this.loLn := pool.addLine(line.new(this.startT, this.lo, this.lastClose, this.lo, xloc = xloc.bar_time, color = lineCol, style = line.style_dotted, width = 1))
        this.tagLb := pool.addLabel(label.new(this.startT, this.hi, this.tag, xloc = xloc.bar_time, style = label.style_label_lower_left, color = color.new(THEME.ink2, 100), textcolor = THEME.ink2, size = size.tiny))
        if shade
            this.shadeBx := pool.addBox(box.new(this.startT, this.hi, this.lastClose, this.lo, xloc = xloc.bar_time, bgcolor = color.new(THEME.ink2, 96), border_color = color.new(THEME.ink2, 100)))
    else if (status == SES_UPDATED or status == SES_COMPLETED) and not na(this.hiLn)
        line.set_xy2(this.hiLn, this.lastClose, this.hi)
        line.set_y1(this.hiLn, this.hi)
        line.set_xy2(this.loLn, this.lastClose, this.lo)
        line.set_y1(this.loLn, this.lo)
        label.set_y(this.tagLb, this.hi)
        if not na(this.shadeBx)
            box.set_top(this.shadeBx, this.hi)
            box.set_bottom(this.shadeBx, this.lo)
            box.set_right(this.shadeBx, this.lastClose)
    status
