// @module core/status
// @requires core/theme, core/time
// @description Quiet version line in the bottom-right corner, plus the untested-timeframe notice (D2.2).

var table coreStatus = table.new(position.bottom_right, 1, 1)
if barstate.islast
    string note = tm_supportedTf(timeframe.period) ? "" : " · untested timeframe: use 1m or 5m"
    table.cell(coreStatus, 0, 0, "NQ.ORB " + NQORB_VERSION + note, text_color = THEME.ink2, text_size = size.small)

// Every indicator needs at least one output call; this hidden plot provides it.
plot(float(na), "NQ.ORB", display = display.none)
