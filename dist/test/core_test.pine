// NQ.ORB test: core · v0.2.0
// GENERATED FILE. Do not edit by hand: edit the files in src/ and tests/,
// then run `python tools/build.py`.
// Modules: core/theme, core/selftest, core/base, core/time, core/price, core/levels, core/events, core/budget, tests/core_selftest
// ============================================================================
//@version=6
indicator("NQ.ORB test: core", shorttitle = "T-core", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// Build constants (generated)
NQORB_VERSION = "0.2.0"
NQORB_TARGET = "test_core"


// ============================================================================
// MODULE core/theme  (src/core/theme.pine)
// Dark/light detection and the DESIGN.md color tokens (rules/core.md §8).
// ============================================================================

// Every module takes its colors from THEME; no module types its own hex color.
type Theme
    color bull
    color bear
    color accent
    color ink
    color ink2
    color faint

th_isDarkBg(color bg) =>
    0.299 * color.r(bg) + 0.587 * color.g(bg) + 0.114 * color.b(bg) < 128

// DESIGN.md §2.1. Validated values: re-run the palette validator before changing them.
th_make(bool dark) =>
    Theme t = na
    if dark
        t := Theme.new(#1BA995, #B45C5E, #B08E21, #D1D4DC, #9598A1, #5D606B)
    else
        t := Theme.new(#1B9786, #A05052, #B48630, #131722, #5D606B, #9598A1)
    t

var Theme THEME = th_make(th_isDarkBg(chart.bg_color))


// ============================================================================
// MODULE core/selftest  (src/core/selftest.pine)
// Self-test framework: records cases and shows the PASS/FAIL table (rules/core.md §9).
// ============================================================================

type TestResult
    string id
    string what
    string expected
    string got
    bool pass

type TestSuite
    string name
    array<TestResult> results

st_new(string name) =>
    TestSuite.new(name, array.new<TestResult>())

method record(TestSuite this, string id, string what, string expected, string got, bool pass) =>
    this.results.push(TestResult.new(id, what, expected, got, pass))
    pass

// Passes when the got text equals the expected text exactly.
method check(TestSuite this, string id, string what, string expected, string got) =>
    this.record(id, what, expected, got, expected == got)

st_yn(bool b) =>
    b ? "yes" : "no"

st_num(float x) =>
    str.tostring(x, "#.####")

// Summary in the top row, then one row per case. Shown top-right.
method render(TestSuite this) =>
    var table grid = table.new(position.top_right, 5, 64, bgcolor = color.new(THEME.ink, 94), frame_color = THEME.faint, frame_width = 1)
    int passed = 0
    for r in this.results
        if r.pass
            passed += 1
    int n = this.results.size()
    bool ok = n > 0 and passed == n
    table.cell(grid, 0, 0, this.name + " " + str.tostring(passed) + "/" + str.tostring(n) + (ok ? " PASS" : " FAIL"), text_color = ok ? THEME.bull : THEME.bear, text_size = size.small, text_halign = text.align_left, text_font_family = font.family_monospace)
    array<string> head = array.from("ID", "What is tested", "Expected", "Got", "Result")
    for [col, h] in head
        table.cell(grid, col, 1, h, text_color = THEME.ink2, text_size = size.small, text_halign = text.align_left)
    for [i, r] in this.results
        int row = i + 2
        table.cell(grid, 0, row, r.id, text_color = THEME.ink2, text_size = size.small, text_halign = text.align_left, text_font_family = font.family_monospace)
        table.cell(grid, 1, row, r.what, text_color = THEME.ink, text_size = size.small, text_halign = text.align_left)
        table.cell(grid, 2, row, r.expected, text_color = THEME.ink2, text_size = size.small, text_halign = text.align_left, text_font_family = font.family_monospace)
        table.cell(grid, 3, row, r.got, text_color = THEME.ink, text_size = size.small, text_halign = text.align_left, text_font_family = font.family_monospace)
        table.cell(grid, 4, row, r.pass ? "PASS" : "FAIL", text_color = r.pass ? THEME.bull : THEME.bear, text_size = size.small, text_font_family = font.family_monospace)
    ok


// ============================================================================
// MODULE core/base  (src/core/base.pine)
// Shared constants and the Candle record every module reads candles through.
// ============================================================================

// All clock times in NQ.ORB are Chicago times (D1.2, D15.3).
CORE_TZ = "America/Chicago"

// One candle, passed explicitly, so the same logic runs on chart candles and on
// scripted self-test candles (rules/core.md §9).
type Candle
    float o
    float h
    float l
    float c
    int t
    int tc

// The current chart candle (t = open time, tc = close time, both in ms).
// Modules only process it once it has closed (barstate.isconfirmed).
core_chartCandle() =>
    Candle.new(open, high, low, close, time, time_close)


// ============================================================================
// MODULE core/time  (src/core/time.pine)
// Trading day, session windows, minute-based durations and timeframe support (rules/core.md §2).
// ============================================================================

TM_MS_PER_MIN = 60000
TM_MS_PER_HOUR = 3600000

// Chicago clock time as minutes after midnight, e.g. tm_hhmm(8, 30) = 510.
tm_hhmm(int h, int m) =>
    h * 60 + m

tm_minuteOfDay(int t) =>
    hour(t, CORE_TZ) * 60 + minute(t, CORE_TZ)

// C1: the trading day runs 17:00 -> 16:00 Chicago. A candle belongs to the Chicago
// calendar date of its open time + 7 hours. Returned as yyyymmdd.
tm_tradingDay(int t) =>
    int shifted = t + 7 * TM_MS_PER_HOUR
    year(shifted, CORE_TZ) * 10000 + month(shifted, CORE_TZ) * 100 + dayofmonth(shifted, CORE_TZ)

// R1: a candle is in a window if it opens at or after the start and closes at or
// before the end. Start and end are Chicago minutes of the day; a window whose end
// is earlier than its start crosses midnight.
tm_inWindow(Candle c, int startMin, int endMin) =>
    int openMin = tm_minuteOfDay(c.t)
    int closeMin = openMin + int(math.round((c.tc - c.t) / 60000.0))
    startMin < endMin ? (openMin >= startMin and closeMin <= endMin) : (openMin >= startMin or closeMin <= endMin)

// D2.4 / R8: a duration that starts at startMs has ended on the first candle that
// closes at or after startMs + minutes.
tm_durationDone(int startMs, int minutes, int candleClose) =>
    candleClose >= startMs + minutes * TM_MS_PER_MIN

// D2.2: 1m and 5m charts are supported; other timeframes run with a notice.
tm_supportedTf(string tf) =>
    tf == "1" or tf == "5"


// ============================================================================
// MODULE core/price  (src/core/price.pine)
// Tick math, the C9 limit rounding rule and Wilder's ATR(14) (rules/core.md §3).
// ============================================================================

PX_EPS = 1e-9

px_ticks(float points, float tick) =>
    points / tick

px_points(float ticks, float tick) =>
    ticks * tick

// C9: a limit that falls exactly between two ticks goes on the tick closer to the
// current price: the higher tick for a long (dir = 1), the lower for a short (dir = -1).
// Anything else rounds to the nearest tick.
px_limitPrice(float raw, float tick, int dir) =>
    float n = raw / tick
    float below = math.floor(n)
    float frac = n - below
    float steps = frac > 0.5 + PX_EPS ? below + 1 : frac < 0.5 - PX_EPS ? below : dir > 0 ? below + 1 : below
    steps * tick

// C6: Wilder's ATR, identical to ta.atr(length), fed one closed candle at a time.
// The first value appears on the length-th candle (the average of the first
// `length` true ranges); after that it is smoothed with alpha = 1 / length.
type Atr
    int length = 14
    int count = 0
    float sumTr = 0.0
    float value
    float prevClose

method update(Atr this, Candle c) =>
    float tr = na(this.prevClose) ? c.h - c.l : math.max(c.h - c.l, math.abs(c.h - this.prevClose), math.abs(c.l - this.prevClose))
    this.count += 1
    if na(this.value)
        this.sumTr += tr
        if this.count >= this.length
            this.value := this.sumTr / this.length
    else
        float alpha = 1.0 / this.length
        this.value := alpha * tr + (1 - alpha) * this.value
    this.prevClose := c.c
    this.value


// ============================================================================
// MODULE core/levels  (src/core/levels.pine)
// Level record and the level-interaction engine: touch, sweep or break (rules/core.md §4–5).
// ============================================================================

LV_SWEEP_MIN_TICKS = 2
LV_TOUCH_TICKS = 2

// Interaction results
LV_NONE = 0
LV_TOUCH = 1
LV_SWEEP = 2
LV_BREAK = 3

// Level states (D5.9: SWEPT and BROKEN are final)
LV_ACTIVE = 0
LV_SWEPT = 1
LV_BROKEN = 2

// isHigh: a high-type level sits above price and is swept upward; low-type is the mirror.
// knownAt: close time (ms) of the candle on which the level became final.
type Level
    string kind
    string id
    bool isHigh
    float price
    int knownAt
    int state = 0
    bool sweepable = true
    bool targetable = true
    int endedAt

lv_new(string kind, string id, bool isHigh, float price, int knownAt, bool sweepable) =>
    Level.new(kind = kind, id = id, isHigh = isHigh, price = price, knownAt = knownAt, state = LV_ACTIVE, sweepable = sweepable, targetable = true)

// Daily levels: kind + trading day, e.g. "PDH-20260925". Swing-based: kind + swing time.
lv_dailyId(string kind, int tradingDay) =>
    kind + "-" + str.tostring(tradingDay)

lv_swingId(string kind, int swingTime) =>
    kind + "-" + str.tostring(swingTime)

// A sweep of a high is bearish (-1); a sweep of a low is bullish (+1).
lv_sweepDir(bool isHigh) =>
    isHigh ? -1 : 1

// The engine (rules/core.md §5): judges one closed candle against one price.
// C4 order break > sweep > touch · C2 a close exactly at the level is not a break ·
// C3 near-misses are touches · R7 a close exactly at the midpoint counts as the far half.
lv_classify(bool isHigh, float price, Candle c, float tick) =>
    float eps = tick * 1e-6
    float mid = (c.h + c.l) / 2.0
    int result = LV_NONE
    if isHigh
        if c.c > price + eps
            result := LV_BREAK
        else if c.h - price >= LV_SWEEP_MIN_TICKS * tick - eps and c.c <= mid + eps
            result := LV_SWEEP
        else if c.h >= price - LV_TOUCH_TICKS * tick - eps
            result := LV_TOUCH
    else
        if c.c < price - eps
            result := LV_BREAK
        else if price - c.l >= LV_SWEEP_MIN_TICKS * tick - eps and c.c >= mid - eps
            result := LV_SWEEP
        else if c.l <= price + LV_TOUCH_TICKS * tick + eps
            result := LV_TOUCH
    result

// Judges an ACTIVE level against a closed candle and updates its state.
// C5: only candles that open at or after the level became known are judged.
method judge(Level this, Candle c, float tick) =>
    int result = LV_NONE
    if this.state == LV_ACTIVE and c.t >= this.knownAt
        result := lv_classify(this.isHigh, this.price, c, tick)
        if result == LV_SWEEP
            this.state := LV_SWEPT
            this.endedAt := c.tc
        else if result == LV_BREAK
            this.state := LV_BROKEN
            this.endedAt := c.tc
    result

// R6: untouched = not yet swept or broken (touches don't count).
method isUntouched(Level this) =>
    this.state == LV_ACTIVE

lv_resultName(int r) =>
    r == LV_TOUCH ? "TOUCH" : r == LV_SWEEP ? "SWEEP" : r == LV_BREAK ? "BREAK" : "none"

lv_stateName(int s) =>
    s == LV_SWEPT ? "SWEPT" : s == LV_BROKEN ? "BROKEN" : "ACTIVE"


// ============================================================================
// MODULE core/events  (src/core/events.pine)
// Event record, unique event IDs and the per-day event store (rules/core.md §6).
// ============================================================================

EV_MAX_PER_DAY = 300

// confirmedAt / confirmedClose: open and close time of the confirming candle.
// extreme: the wick extreme for sweeps and failures (used for stops, D11.1 / R2).
// used: set once the event is attached to a setup or rejected candidate (L-2).
type Event
    string kind
    int dir
    string levelId
    float levelPrice
    float extreme
    int confirmedAt
    int confirmedClose
    bool used = false
    string id

// kind : direction : level ID : confirming-candle open time,
// e.g. "SWEEP:+1:LOL-20260925:1790343900000".
ev_makeId(string kind, int dir, string levelId, int confirmedAt) =>
    kind + ":" + (dir > 0 ? "+1" : "-1") + ":" + (levelId == "" ? "-" : levelId) + ":" + str.tostring(confirmedAt)

ev_new(string kind, int dir, string levelId, float levelPrice, float extreme, Candle c) =>
    Event.new(kind = kind, dir = dir, levelId = levelId, levelPrice = levelPrice, extreme = extreme, confirmedAt = c.t, confirmedClose = c.tc, used = false, id = ev_makeId(kind, dir, levelId, c.t))

method markUsed(Event this) =>
    this.used := true
    this

// One trading day of events; cleared at the daily reset (17:00 Chicago).
type EventStore
    array<Event> items
    int day

ev_newStore() =>
    EventStore.new(array.new<Event>(), na)

method add(EventStore this, Event e) =>
    this.items.push(e)
    if this.items.size() > EV_MAX_PER_DAY
        this.items.shift()
    e

// Clears the store when a new trading day starts. Returns true if it did.
method resetIfNewDay(EventStore this, int tradingDay) =>
    bool isNew = na(this.day) or tradingDay != this.day
    if isNew
        this.items.clear()
        this.day := tradingDay
    isNew

method findById(EventStore this, string id) =>
    Event found = na
    for e in this.items
        if e.id == id
            found := e
            break
    found


// ============================================================================
// MODULE core/budget  (src/core/budget.pine)
// Per-module drawing budgets within TradingView's 500-object limits (rules/core.md §7).
// ============================================================================

// [lines, labels, boxes] each module may keep. Unknown owners get nothing.
db_limits(string owner) =>
    switch owner
        "orb" => array.from(20, 20, 10)
        "liquidity" => array.from(80, 80, 0)
        "structure" => array.from(60, 60, 0)
        "fvg" => array.from(20, 0, 80)
        "zones" => array.from(0, 0, 40)
        "sessions" => array.from(40, 20, 20)
        "setups" => array.from(80, 80, 20)
        "notices" => array.from(20, 20, 0)
        => array.from(0, 0, 0)

var array<string> DB_OWNERS = array.from("orb", "liquidity", "structure", "fvg", "zones", "sessions", "setups", "notices")

type DrawPool
    string owner
    int maxLines
    int maxLabels
    int maxBoxes
    array<line> lines
    array<label> labels
    array<box> boxes

db_newPool(string owner) =>
    array<int> lim = db_limits(owner)
    DrawPool.new(owner, lim.get(0), lim.get(1), lim.get(2), array.new<line>(), array.new<label>(), array.new<box>())

// Each add keeps the new object; when the pool is over budget, its oldest objects
// are deleted first (only older history is affected, never the live morning).
method addLine(DrawPool this, line obj) =>
    this.lines.push(obj)
    while this.lines.size() > this.maxLines
        line.delete(this.lines.shift())
    obj

method addLabel(DrawPool this, label obj) =>
    this.labels.push(obj)
    while this.labels.size() > this.maxLabels
        label.delete(this.labels.shift())
    obj

method addBox(DrawPool this, box obj) =>
    this.boxes.push(obj)
    while this.boxes.size() > this.maxBoxes
        box.delete(this.boxes.shift())
    obj


// ============================================================================
// MODULE tests/core_selftest  (tests/core_selftest.pine)
// Core self-tests (TESTING.md §3.1): 31 scripted cases shown in a PASS/FAIL table. Works on any chart.
// ============================================================================

T_TICK = 0.25
T_BASE = timestamp(CORE_TZ, 2026, 9, 21, 9, 0)

// Scripted 5-minute candle number k after T_BASE (Monday 2026-09-21 09:00 Chicago).
t_bar(int k, float o, float h, float l, float c) =>
    Candle.new(o, h, l, c, T_BASE + k * 5 * TM_MS_PER_MIN, T_BASE + (k + 1) * 5 * TM_MS_PER_MIN)

// Judges one scripted candle against a fresh high-type level at `price` (clean state per case).
t_judgeHigh(float price, Candle c) =>
    Level lvl = lv_new("T", "T-1", true, price, T_BASE, true)
    lv_resultName(lvl.judge(c, T_TICK))

// First candle close (HH:mm Chicago) that ends a duration, for candles of `candleMin` minutes.
t_durationEnd(int startMs, int minutes, int candleMin) =>
    int endClose = na
    for k = 0 to 120
        int cl = startMs + (k + 1) * candleMin * TM_MS_PER_MIN
        if tm_durationDone(startMs, minutes, cl)
            endClose := cl
            break
    str.format_time(endClose, "HH:mm", CORE_TZ)

// PX-04: the core ATR must equal ta.atr(14) on every closed chart candle.
var Atr t_atr = Atr.new()
var float t_atrMaxDiff = 0.0
var int t_atrCompared = 0
var int t_atrStartMismatch = 0
float t_refAtr = ta.atr(14)
if barstate.isconfirmed
    float mine = t_atr.update(core_chartCandle())
    if na(mine) != na(t_refAtr)
        t_atrStartMismatch += 1
    else if not na(mine)
        t_atrMaxDiff := math.max(t_atrMaxDiff, math.abs(mine - t_refAtr))
        t_atrCompared += 1

if barstate.islast
    TestSuite s = st_new("CORE")

    // ---- Level interaction: high-type level at 100.00 unless stated
    s.check("LI-01", "High 2 ticks below, no penetration", "TOUCH", t_judgeHigh(100.0, t_bar(0, 99.0, 99.5, 98.5, 99.0)))
    Level l2 = lv_new("T", "T-2", true, 100.0, T_BASE, true)
    string r2 = lv_resultName(l2.judge(t_bar(0, 99.5, 100.5, 99.0, 99.5), T_TICK))
    s.check("LI-02", "2 ticks through, closes back in far half", "SWEEP · SWEPT", r2 + " · " + lv_stateName(l2.state))
    s.check("LI-03", "Only 1 tick through (C3)", "TOUCH", t_judgeHigh(100.0, t_bar(0, 99.5, 100.25, 99.0, 99.5)))
    s.check("LI-04", "Through, but closes in near half (C3)", "TOUCH", t_judgeHigh(100.0, t_bar(0, 99.5, 100.5, 98.5, 99.75)))
    Level l5 = lv_new("T", "T-5", true, 100.0, T_BASE, true)
    string r5 = lv_resultName(l5.judge(t_bar(0, 99.5, 100.5, 99.5, 100.25), T_TICK))
    s.check("LI-05", "Closes beyond the level", "BREAK · BROKEN", r5 + " · " + lv_stateName(l5.state))
    Level l6 = lv_new("T", "T-6", true, 100.0, T_BASE, true)
    l6.judge(t_bar(0, 99.5, 100.5, 99.0, 99.5), T_TICK)
    s.check("LI-06", "Already swept level, swept again", "none", lv_resultName(l6.judge(t_bar(1, 99.5, 100.5, 99.0, 99.5), T_TICK)))
    s.check("LI-07", "Close exactly at the midpoint (R7)", "SWEEP", t_judgeHigh(100.0, t_bar(0, 99.5, 100.5, 99.0, 99.75)))
    s.check("LI-08", "Close exactly at the level (C2)", "SWEEP", t_judgeHigh(100.0, t_bar(0, 99.75, 100.5, 99.5, 100.0)))
    Level l9 = lv_new("T", "T-9", true, 100.0, T_BASE + 5 * TM_MS_PER_MIN, true)
    string r9a = lv_resultName(l9.judge(t_bar(0, 99.5, 100.5, 99.0, 99.5), T_TICK))
    string r9b = lv_resultName(l9.judge(t_bar(1, 99.5, 100.5, 99.0, 99.5), T_TICK))
    s.check("LI-09", "Not judged on its own creating candle (C5)", "none, then SWEEP", r9a + ", then " + r9b)
    Level l10 = lv_new("T", "T-10", false, 100.0, T_BASE, true)
    string r10 = lv_resultName(l10.judge(t_bar(0, 100.5, 101.0, 99.5, 100.5), T_TICK))
    s.check("LI-10", "Low-type level, mirrored", "SWEEP, bullish", r10 + ", " + (lv_sweepDir(false) > 0 ? "bullish" : "bearish"))
    Candle c11 = t_bar(0, 99.5, 100.75, 99.0, 99.5)
    Level a11 = lv_new("T", "T-11a", true, 100.0, T_BASE, true)
    Level b11 = lv_new("T", "T-11b", true, 100.25, T_BASE, true)
    s.check("LI-11", "Two levels swept by one candle (C7)", "SWEEP + SWEEP", lv_resultName(a11.judge(c11, T_TICK)) + " + " + lv_resultName(b11.judge(c11, T_TICK)))
    s.check("LI-12", "Big wick and close beyond (C4)", "BREAK", t_judgeHigh(100.0, t_bar(0, 100.0, 103.0, 99.5, 100.25)))
    s.check("LI-13", "High 3 ticks below the level", "none", t_judgeHigh(100.0, t_bar(0, 99.0, 99.25, 98.75, 99.0)))

    // ---- Time
    string tm1a = str.tostring(tm_tradingDay(timestamp(CORE_TZ, 2026, 9, 21, 16, 55)))
    string tm1b = str.tostring(tm_tradingDay(timestamp(CORE_TZ, 2026, 9, 21, 17, 0)))
    s.check("TM-01", "Trading day, Mon 16:55 / Mon 17:00 (C1)", "20260921 / 20260922", tm1a + " / " + tm1b)
    array<int> tm2Opens = array.from(timestamp(CORE_TZ, 2026, 9, 22, 8, 25), timestamp(CORE_TZ, 2026, 9, 22, 8, 30), timestamp(CORE_TZ, 2026, 9, 22, 10, 55), timestamp(CORE_TZ, 2026, 9, 22, 11, 0))
    array<string> tm2Got = array.new<string>()
    for o in tm2Opens
        tm2Got.push(st_yn(tm_inWindow(Candle.new(0, 0, 0, 0, o, o + 5 * TM_MS_PER_MIN), tm_hhmm(8, 30), tm_hhmm(11, 0))))
    s.check("TM-02", "In NY AM: 5m opens 08:25/08:30/10:55/11:00 (R1)", "no,yes,yes,no", tm2Got.join(","))
    s.check("TM-03", "1m: 30 min from the 09:02 close", "09:32", t_durationEnd(timestamp(CORE_TZ, 2026, 9, 22, 9, 2), 30, 1))
    s.check("TM-04", "5m: 30 min from the 09:05 close", "09:35", t_durationEnd(timestamp(CORE_TZ, 2026, 9, 22, 9, 5), 30, 5))
    string tm5a = str.format_time(timestamp(CORE_TZ, 2026, 3, 9, 8, 0), "HH:mm", "UTC")
    string tm5b = str.format_time(timestamp(CORE_TZ, 2026, 11, 2, 8, 0), "HH:mm", "UTC")
    s.check("TM-05", "08:00 Chicago after the Mar / Nov clock change, in UTC", "13:00 / 14:00", tm5a + " / " + tm5b)
    array<string> tm6Got = array.new<string>()
    for tf in array.from("1", "5", "3", "15", "60")
        tm6Got.push(st_yn(tm_supportedTf(tf)))
    s.check("TM-06", "Supported timeframes 1/5/3/15/60 (D2.2)", "yes,yes,no,no,no", tm6Got.join(","))
    EventStore st7 = ev_newStore()
    st7.resetIfNewDay(20260921)
    st7.add(ev_new("SWEEP", 1, "X-1", 100.0, 99.5, t_bar(0, 100.0, 100.0, 100.0, 100.0)))
    st7.resetIfNewDay(20260921)
    int kept7 = st7.items.size()
    st7.resetIfNewDay(20260922)
    s.check("TM-07", "Event store at same day / new trading day", "kept 1 · cleared 0", "kept " + str.tostring(kept7) + " · cleared " + str.tostring(st7.items.size()))

    // ---- Price
    s.check("PX-01", "Limit at 50 % of FVG 100.00–101.00", "100.5", st_num(px_limitPrice((100.0 + 101.0) / 2, T_TICK, 1)))
    s.check("PX-02", "50 % = 100.375: long / short (C9)", "100.5 / 100.25", st_num(px_limitPrice(100.375, T_TICK, 1)) + " / " + st_num(px_limitPrice(100.375, T_TICK, -1)))
    s.check("PX-03", "20 points in ticks", "80", st_num(px_ticks(20.0, T_TICK)))
    string px4 = "diff " + str.tostring(t_atrMaxDiff, "0.0000000000") + " · " + str.tostring(t_atrCompared) + " candles · start mismatches " + str.tostring(t_atrStartMismatch)
    s.record("PX-04", "Core ATR(14) vs ta.atr(14) on this chart (C6)", "diff ≤ 1e-9 · 0 start mismatches", px4, t_atrCompared > 0 and t_atrMaxDiff <= 1e-9 and t_atrStartMismatch == 0)

    // ---- Events
    int evT = timestamp(CORE_TZ, 2026, 9, 25, 8, 45)
    Candle evC = Candle.new(100.0, 100.0, 99.0, 100.0, evT, evT + 5 * TM_MS_PER_MIN)
    Event e1 = ev_new("SWEEP", 1, "LOL-20260925", 100.0, 99.0, evC)
    Event e1b = ev_new("SWEEP", 1, "LOL-20260925", 100.0, 99.0, evC)
    s.check("EV-01", "Same event twice gives the same ID", "SWEEP:+1:LOL-20260925:1790343900000 (same)", e1.id + (e1.id == e1b.id ? " (same)" : " (different)"))
    Event e2 = ev_new("SWEEP", 1, "ASL-20260925", 100.0, 99.0, evC)
    s.check("EV-02", "Two levels swept on one candle", "different IDs", e1.id != e2.id ? "different IDs" : "same ID")
    EventStore st3 = ev_newStore()
    st3.add(e1)
    e1.markUsed()
    Event f3 = st3.findById(e1.id)
    s.check("EV-03", "A used event stays used in the store", "used", na(f3) ? "missing" : f3.used ? "used" : "unused")
    EventStore st4 = ev_newStore()
    for k = 0 to EV_MAX_PER_DAY + 4
        st4.add(ev_new("SWEEP", 1, "L-" + str.tostring(k), 100.0, 99.0, t_bar(k, 100.0, 100.0, 100.0, 100.0)))
    s.check("EV-04", "305 events in one day", "300 kept · oldest L-5", str.tostring(st4.items.size()) + " kept · oldest " + st4.items.first().levelId)

    // ---- Drawing budget
    DrawPool p1 = DrawPool.new("test", 20, 0, 0, array.new<line>(), array.new<label>(), array.new<box>())
    int linesBefore = line.all.size()
    for k = 1 to 25
        p1.addLine(line.new(bar_index - k, close, bar_index, close, color = color.new(THEME.faint, 100)))
    int keptLines = p1.lines.size()
    int onChart = line.all.size() - linesBefore
    for ln in p1.lines
        line.delete(ln)
    s.check("DB-01", "Budget 20 lines, 25 created", "20 kept · 20 on chart", str.tostring(keptLines) + " kept · " + str.tostring(onChart) + " on chart")
    int sumLines = 0
    int sumLabels = 0
    int sumBoxes = 0
    for owner in DB_OWNERS
        array<int> lim = db_limits(owner)
        sumLines += lim.get(0)
        sumLabels += lim.get(1)
        sumBoxes += lim.get(2)
    s.record("DB-02", "All budgets within 500 lines / labels / boxes", "320 / 280 / 170", str.tostring(sumLines) + " / " + str.tostring(sumLabels) + " / " + str.tostring(sumBoxes), sumLines <= 500 and sumLabels <= 500 and sumBoxes <= 500)

    // ---- Theme
    s.check("TH-01", "Background #131722 / #FFFFFF", "dark / light", (th_isDarkBg(#131722) ? "dark" : "light") + " / " + (th_isDarkBg(#FFFFFF) ? "dark" : "light"))

    s.render()

// Every indicator needs at least one output call; this hidden plot provides it.
plot(float(na), "Self-test", display = display.none)
