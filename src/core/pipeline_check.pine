// @module core/pipeline_check
// @description Phase 0 placeholder: proves the build-to-TradingView pipeline works. No trading logic; replaced in Phase 1.

// A small, quiet status line in the bottom-right corner. Its ink is derived from
// the chart's own text color, so it stays readable on dark and light charts
// (docs/DESIGN.md §2.3).
var table pipelineStatus = table.new(position.bottom_right, 1, 1)
if barstate.islast
    table.cell(pipelineStatus, 0, 0, "NQ.ORB " + NQORB_VERSION + " · pipeline check · no trading logic yet", text_color = color.new(chart.fg_color, 35), text_size = size.small)

// Every indicator needs at least one output call; this hidden plot provides it.
plot(float(na), "Pipeline check", display = display.none)
