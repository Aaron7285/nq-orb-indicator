// ============================================================================
// NQ.ORB test: sessions · v0.2.0
// GENERATED FILE. Do not edit by hand: edit the files in src/ and tests/,
// then run `python tools/build.py`.
// Modules: core/theme, core/selftest, core/base, core/time, core/budget, modules/sessions_core, tests/sessions_selftest
// ============================================================================
//@version=6
indicator("NQ.ORB test: sessions", shorttitle = "T-sess", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// Build constants (generated)
NQORB_VERSION = "0.2.0"
NQORB_TARGET = "test_sessions"


// ============================================================================
// MODULE core/theme  (src/core/theme.pine)
// Dark/light detection and the DESIGN.md color tokens (rules/core.md §8).
// ============================================================================

// Every module takes its colors from THEME; no module types its own hex color.
type Theme
    color bull
    color bear
    color accent
    color ink
    color ink2
    color faint

th_isDarkBg(color bg) =>
    0.299 * color.r(bg) + 0.587 * color.g(bg) + 0.114 * color.b(bg) < 128

// DESIGN.md §2.1. Validated values: re-run the palette validator before changing them.
th_make(bool dark) =>
    Theme t = na
    if dark
        t := Theme.new(#1BA995, #B45C5E, #B08E21, #D1D4DC, #9598A1, #5D606B)
    else
        t := Theme.new(#1B9786, #A05052, #B48630, #131722, #5D606B, #9598A1)
    t

var Theme THEME = th_make(th_isDarkBg(chart.bg_color))


// ============================================================================
// MODULE core/selftest  (src/core/selftest.pine)
// Self-test framework: records cases and shows the PASS/FAIL table (rules/core.md §9).
// ============================================================================

type TestResult
    string id
    string what
    string expected
    string got
    bool pass

type TestSuite
    string name
    array<TestResult> results

st_new(string name) =>
    TestSuite.new(name, array.new<TestResult>())

method record(TestSuite this, string id, string what, string expected, string got, bool pass) =>
    this.results.push(TestResult.new(id, what, expected, got, pass))
    pass

// Passes when the got text equals the expected text exactly.
method check(TestSuite this, string id, string what, string expected, string got) =>
    this.record(id, what, expected, got, expected == got)

st_yn(bool b) =>
    b ? "yes" : "no"

st_num(float x) =>
    str.tostring(x, "#.####")

// Summary in the top row, then one row per case. Shown top-right.
method render(TestSuite this) =>
    var table grid = table.new(position.top_right, 5, 64, bgcolor = color.new(THEME.ink, 94), frame_color = THEME.faint, frame_width = 1)
    int passed = 0
    for r in this.results
        if r.pass
            passed += 1
    int n = this.results.size()
    bool ok = n > 0 and passed == n
    table.cell(grid, 0, 0, this.name + " " + str.tostring(passed) + "/" + str.tostring(n) + (ok ? " PASS" : " FAIL"), text_color = ok ? THEME.bull : THEME.bear, text_size = size.small, text_halign = text.align_left, text_font_family = font.family_monospace)
    array<string> head = array.from("ID", "What is tested", "Expected", "Got", "Result")
    for [col, h] in head
        table.cell(grid, col, 1, h, text_color = THEME.ink2, text_size = size.small, text_halign = text.align_left)
    for [i, r] in this.results
        int row = i + 2
        table.cell(grid, 0, row, r.id, text_color = THEME.ink2, text_size = size.small, text_halign = text.align_left, text_font_family = font.family_monospace)
        table.cell(grid, 1, row, r.what, text_color = THEME.ink, text_size = size.small, text_halign = text.align_left)
        table.cell(grid, 2, row, r.expected, text_color = THEME.ink2, text_size = size.small, text_halign = text.align_left, text_font_family = font.family_monospace)
        table.cell(grid, 3, row, r.got, text_color = THEME.ink, text_size = size.small, text_halign = text.align_left, text_font_family = font.family_monospace)
        table.cell(grid, 4, row, r.pass ? "PASS" : "FAIL", text_color = r.pass ? THEME.bull : THEME.bear, text_size = size.small, text_font_family = font.family_monospace)
    ok


// ============================================================================
// MODULE core/base  (src/core/base.pine)
// Shared constants and the Candle record every module reads candles through.
// ============================================================================

// All clock times in NQ.ORB are Chicago times (D1.2, D15.3).
CORE_TZ = "America/Chicago"

// One candle, passed explicitly, so the same logic runs on chart candles and on
// scripted self-test candles (rules/core.md §9).
type Candle
    float o
    float h
    float l
    float c
    int t
    int tc

// The current chart candle (t = open time, tc = close time, both in ms).
// Modules only process it once it has closed (barstate.isconfirmed).
core_chartCandle() =>
    Candle.new(open, high, low, close, time, time_close)


// ============================================================================
// MODULE core/time  (src/core/time.pine)
// Trading day, session windows, minute-based durations and timeframe support (rules/core.md §2).
// ============================================================================

TM_MS_PER_MIN = 60000
TM_MS_PER_HOUR = 3600000

// Chicago clock time as minutes after midnight, e.g. tm_hhmm(8, 30) = 510.
tm_hhmm(int h, int m) =>
    h * 60 + m

tm_minuteOfDay(int t) =>
    hour(t, CORE_TZ) * 60 + minute(t, CORE_TZ)

// C1: the trading day runs 17:00 -> 16:00 Chicago. A candle belongs to the Chicago
// calendar date of its open time + 7 hours. Returned as yyyymmdd.
tm_tradingDay(int t) =>
    int shifted = t + 7 * TM_MS_PER_HOUR
    year(shifted, CORE_TZ) * 10000 + month(shifted, CORE_TZ) * 100 + dayofmonth(shifted, CORE_TZ)

// R1: a candle is in a window if it opens at or after the start and closes at or
// before the end. Start and end are Chicago minutes of the day; a window whose end
// is earlier than its start crosses midnight.
tm_inWindow(Candle c, int startMin, int endMin) =>
    int openMin = tm_minuteOfDay(c.t)
    int closeMin = openMin + int(math.round((c.tc - c.t) / 60000.0))
    startMin < endMin ? (openMin >= startMin and closeMin <= endMin) : (openMin >= startMin or closeMin <= endMin)

// D2.4 / R8: a duration that starts at startMs has ended on the first candle that
// closes at or after startMs + minutes.
tm_durationDone(int startMs, int minutes, int candleClose) =>
    candleClose >= startMs + minutes * TM_MS_PER_MIN

// D2.2: 1m and 5m charts are supported; other timeframes run with a notice.
tm_supportedTf(string tf) =>
    tf == "1" or tf == "5"


// ============================================================================
// MODULE core/budget  (src/core/budget.pine)
// Per-module drawing budgets within TradingView's 500-object limits (rules/core.md §7).
// ============================================================================

// [lines, labels, boxes] each module may keep. Unknown owners get nothing.
db_limits(string owner) =>
    switch owner
        "orb" => array.from(20, 20, 10)
        "liquidity" => array.from(80, 80, 0)
        "structure" => array.from(60, 60, 0)
        "fvg" => array.from(20, 0, 80)
        "zones" => array.from(0, 0, 40)
        "sessions" => array.from(40, 20, 20)
        "setups" => array.from(80, 80, 20)
        "notices" => array.from(20, 20, 0)
        => array.from(0, 0, 0)

var array<string> DB_OWNERS = array.from("orb", "liquidity", "structure", "fvg", "zones", "sessions", "setups", "notices")

type DrawPool
    string owner
    int maxLines
    int maxLabels
    int maxBoxes
    array<line> lines
    array<label> labels
    array<box> boxes

db_newPool(string owner) =>
    array<int> lim = db_limits(owner)
    DrawPool.new(owner, lim.get(0), lim.get(1), lim.get(2), array.new<line>(), array.new<label>(), array.new<box>())

// Each add keeps the new object; when the pool is over budget, its oldest objects
// are deleted first (only older history is affected, never the live morning).
method addLine(DrawPool this, line obj) =>
    this.lines.push(obj)
    while this.lines.size() > this.maxLines
        line.delete(this.lines.shift())
    obj

method addLabel(DrawPool this, label obj) =>
    this.labels.push(obj)
    while this.labels.size() > this.maxLabels
        label.delete(this.labels.shift())
    obj

method addBox(DrawPool this, box obj) =>
    this.boxes.push(obj)
    while this.boxes.size() > this.maxBoxes
        box.delete(this.boxes.shift())
    obj


// ============================================================================
// MODULE modules/sessions_core  (src/modules/sessions_core.pine)
// Session tracker: membership, high/low/open per session instance, most recent completed range, drawing (rules/sessions.md).
// ============================================================================

// update() results
SES_NONE = 0
SES_STARTED = 1
SES_UPDATED = 2
SES_COMPLETED = 3

// One session definition plus its running state. Times are Chicago minutes of the day.
// hi/lo/op: the current (or just finished) instance. last*: the most recent COMPLETED
// instance (D15.4: only the most recent one is kept; it is replaced each day).
type SessionTracker
    string key
    string tag
    int startMin
    int endMin
    bool active = false
    int day
    float hi
    float lo
    float op
    int startT
    int lastClose
    bool partial = false
    float lastHi
    float lastLo
    float lastOp
    int lastKnownAt
    int lastDay
    bool lastPartial = false
    line hiLn
    line loLn
    label tagLb
    box shadeBx

ses_new(string key, string tag, int startMin, int endMin) =>
    SessionTracker.new(key = key, tag = tag, startMin = startMin, endMin = endMin)

// Session inputs are typed as HHMM, e.g. 1900 -> 19:00 -> 1140 minutes.
ses_hhmmToMin(int hhmm) =>
    int(math.floor(hhmm / 100.0)) * 60 + hhmm % 100

// R1 membership of one candle.
method contains(SessionTracker this, Candle c) =>
    tm_inWindow(c, this.startMin, this.endMin)

method complete(SessionTracker this) =>
    this.active := false
    this.lastHi := this.hi
    this.lastLo := this.lo
    this.lastOp := this.op
    this.lastKnownAt := this.lastClose
    this.lastDay := this.day
    this.lastPartial := this.partial

// Feed one CLOSED candle. An instance starts at the first candle inside the window and
// completes on the candle that closes at the window end, or, if that candle is missing
// (holiday, early close, data gap), on the first candle after it. The completed range
// becomes known at the close of its last candle inside the window (core C5 uses this).
method update(SessionTracker this, Candle c) =>
    int status = SES_NONE
    bool inWin = this.contains(c)
    int d = tm_tradingDay(c.t)
    if this.active and (not inWin or d != this.day)
        this.complete()
        status := SES_COMPLETED
    if inWin
        if not this.active
            this.active := true
            this.day := d
            this.hi := c.h
            this.lo := c.l
            this.op := c.o
            this.startT := c.t
            this.partial := tm_minuteOfDay(c.t) != this.startMin
            status := SES_STARTED
        else
            this.hi := math.max(this.hi, c.h)
            this.lo := math.min(this.lo, c.l)
            status := SES_UPDATED
        this.lastClose := c.tc
        if tm_minuteOfDay(c.tc) == this.endMin % 1440
            this.complete()
            status := SES_COMPLETED
    status

// DESIGN.md §6.6: faint dotted outline of the session's high/low (tier 3), a tiny tag
// at its start, optional 96 % shade. Called after update() on closed chart candles.
method draw(SessionTracker this, int status, DrawPool pool, bool shade) =>
    color lineCol = color.new(THEME.ink2, 60)
    if status == SES_STARTED
        this.hiLn := pool.addLine(line.new(this.startT, this.hi, this.lastClose, this.hi, xloc = xloc.bar_time, color = lineCol, style = line.style_dotted, width = 1))
        this.loLn := pool.addLine(line.new(this.startT, this.lo, this.lastClose, this.lo, xloc = xloc.bar_time, color = lineCol, style = line.style_dotted, width = 1))
        this.tagLb := pool.addLabel(label.new(this.startT, this.hi, this.tag, xloc = xloc.bar_time, style = label.style_label_lower_left, color = color.new(THEME.ink2, 100), textcolor = THEME.ink2, size = size.tiny))
        if shade
            this.shadeBx := pool.addBox(box.new(this.startT, this.hi, this.lastClose, this.lo, xloc = xloc.bar_time, bgcolor = color.new(THEME.ink2, 96), border_color = color.new(THEME.ink2, 100)))
    else if (status == SES_UPDATED or status == SES_COMPLETED) and not na(this.hiLn)
        line.set_xy2(this.hiLn, this.lastClose, this.hi)
        line.set_y1(this.hiLn, this.hi)
        line.set_xy2(this.loLn, this.lastClose, this.lo)
        line.set_y1(this.loLn, this.lo)
        label.set_y(this.tagLb, this.hi)
        if not na(this.shadeBx)
            box.set_top(this.shadeBx, this.hi)
            box.set_bottom(this.shadeBx, this.lo)
            box.set_right(this.shadeBx, this.lastClose)
    status


// ============================================================================
// MODULE tests/sessions_selftest  (tests/sessions_selftest.pine)
// Sessions self-tests (TESTING.md §3.4, SE series): scripted Chicago candles, PASS/FAIL table.
// ============================================================================

// Scripted candle k of `len` minutes after t0, with the given high/low (open 99.5, close 99.5).
t_sc(int t0, int k, int len, float h, float l) =>
    Candle.new(99.5, h, l, 99.5, t0 + k * len * TM_MS_PER_MIN, t0 + (k + 1) * len * TM_MS_PER_MIN)

t_hm(int t) =>
    str.format_time(t, "HH:mm", CORE_TZ)

// Feeds a full Asia session (19:00–23:00) of `len`-minute candles on the given date.
// The high 105 is at 20:00, the low 96 at 21:30; every other candle is 100 / 99.
t_runAsia(SessionTracker s, int y, int mo, int d, int len, float hiVal) =>
    int t0 = timestamp(CORE_TZ, y, mo, d, 19, 0)
    int n = int(240 / len)
    int last = SES_NONE
    for k = 0 to n - 1
        int mins = k * len
        float h = mins == 60 ? hiVal : 100.0
        float l = mins == 150 ? 96.0 : 99.0
        last := s.update(t_sc(t0, k, len, h, l))
    last

if barstate.islast
    TestSuite s = st_new("SESSIONS")

    SessionTracker a1 = ses_new("ASIA", "Asia", 1140, 1380)
    int before = timestamp(CORE_TZ, 2026, 9, 21, 18, 55)
    a1.update(t_sc(before, 0, 5, 200.0, 0.0))
    int lastStatus = t_runAsia(a1, 2026, 9, 21, 5, 105.0)
    a1.update(t_sc(timestamp(CORE_TZ, 2026, 9, 21, 23, 0), 0, 5, 300.0, 1.0))
    s.check("SE-01", "Asia 5m: high / low / open / known at", "105 / 96 / 99.5 / 23:00", st_num(a1.lastHi) + " / " + st_num(a1.lastLo) + " / " + st_num(a1.lastOp) + " / " + t_hm(a1.lastKnownAt))
    s.check("SE-02", "18:55 and 23:00 candles are outside Asia (R1)", "high 105, low 96", "high " + st_num(a1.lastHi) + ", low " + st_num(a1.lastLo))
    s.check("SE-03", "Completes on the candle closing at 23:00", "COMPLETED", lastStatus == SES_COMPLETED ? "COMPLETED" : "not completed")
    s.check("SE-04", "Trading day of the 19:00 Asia session (C1)", "20260922", str.tostring(a1.lastDay))

    SessionTracker a2 = ses_new("ASIA", "Asia", 1140, 1380)
    t_runAsia(a2, 2026, 9, 21, 1, 105.0)
    s.check("SE-05", "Asia on 1m gives the same range as on 5m", "105 / 96 / 23:00", st_num(a2.lastHi) + " / " + st_num(a2.lastLo) + " / " + t_hm(a2.lastKnownAt))
    t_runAsia(a2, 2026, 9, 22, 1, 110.0)
    s.check("SE-06", "Next day's Asia replaces the most recent (D15.4)", "110 · 20260923", st_num(a2.lastHi) + " · " + str.tostring(a2.lastDay))

    SessionTracker l1 = ses_new("LONDON", "London", 60, 240)
    int lt0 = timestamp(CORE_TZ, 2026, 9, 22, 1, 0)
    for k = 0 to 179
        l1.update(t_sc(lt0, k, 1, k == 90 ? 104.0 : 100.0, k == 10 ? 97.0 : 99.0))
    s.check("SE-07", "London 1m 01:00–04:00: high / low / known at", "104 / 97 / 04:00", st_num(l1.lastHi) + " / " + st_num(l1.lastLo) + " / " + t_hm(l1.lastKnownAt))

    SessionTracker l2 = ses_new("LONDON", "London", 60, 240)
    for k = 0 to 30
        l2.update(t_sc(lt0, k, 5, 101.0, 99.0))
    bool stillOpen = l2.active
    l2.update(t_sc(timestamp(CORE_TZ, 2026, 9, 22, 5, 0), 0, 5, 150.0, 50.0))
    s.check("SE-08", "Missing end candle: completes on the next candle", "open, then known at 03:35", (stillOpen ? "open" : "closed") + ", then known at " + t_hm(l2.lastKnownAt))

    SessionTracker a3 = ses_new("ASIA", "Asia", 1140, 1380)
    int pt0 = timestamp(CORE_TZ, 2026, 9, 21, 20, 30)
    for k = 0 to 29
        a3.update(t_sc(pt0, k, 5, 100.0, 99.0))
    SessionTracker a4 = ses_new("ASIA", "Asia", 1140, 1380)
    t_runAsia(a4, 2026, 9, 21, 5, 105.0)
    s.check("SE-09", "Session first seen at 20:30 / from 19:00 is partial", "yes / no", st_yn(a3.lastPartial) + " / " + st_yn(a4.lastPartial))

    SessionTracker am = ses_new("NYAM", "NY AM", ses_hhmmToMin(830), ses_hhmmToMin(1100))
    array<string> amGot = array.new<string>()
    for hm in array.from(825, 830, 1055, 1100)
        amGot.push(st_yn(am.contains(t_sc(timestamp(CORE_TZ, 2026, 9, 22, int(math.floor(hm / 100.0)), hm % 100), 0, 5, 100.0, 99.0))))
    s.check("SE-10", "Tradeable (NY AM) 5m opens 08:25/08:30/10:55/11:00", "no,yes,yes,no", amGot.join(","))

    SessionTracker ny = ses_new("NY", "New York", 510, 900)
    SessionTracker pm = ses_new("NYPM", "NY PM", 750, 900)
    Candle c0900 = t_sc(timestamp(CORE_TZ, 2026, 9, 22, 9, 0), 0, 5, 100.0, 99.0)
    Candle c1230 = t_sc(timestamp(CORE_TZ, 2026, 9, 22, 12, 30), 0, 5, 100.0, 99.0)
    s.check("SE-11", "Overlaps: 09:00 in NY / NY AM; 12:30 in NY / NY PM", "yes,yes · yes,yes", st_yn(ny.contains(c0900)) + "," + st_yn(am.contains(c0900)) + " · " + st_yn(ny.contains(c1230)) + "," + st_yn(pm.contains(c1230)))

    int w = timestamp(CORE_TZ, 2027, 1, 11, 19, 0)
    SessionTracker a5 = ses_new("ASIA", "Asia", 1140, 1380)
    s.check("SE-12", "Winter: 19:00 Chicago is in Asia (in UTC)", "yes · 01:00", st_yn(a5.contains(t_sc(w, 0, 5, 100.0, 99.0))) + " · " + str.format_time(w, "HH:mm", "UTC"))

    s.check("SE-13", "HHMM settings: 1900 / 130 / 2300 in minutes", "1140 / 90 / 1380", str.tostring(ses_hhmmToMin(1900)) + " / " + str.tostring(ses_hhmmToMin(130)) + " / " + str.tostring(ses_hhmmToMin(2300)))

    s.render()

// Every indicator needs at least one output call; this hidden plot provides it.
plot(float(na), "Self-test", display = display.none)
