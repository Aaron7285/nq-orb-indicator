// @module tests/sessions_selftest
// @requires core/selftest, modules/sessions_core, core/base, core/time
// @description Sessions self-tests (TESTING.md §3.4, SE series): scripted Chicago candles, PASS/FAIL table.

// Scripted candle k of `len` minutes after t0, with the given high/low (open 99.5, close 99.5).
t_sc(int t0, int k, int len, float h, float l) =>
    Candle.new(99.5, h, l, 99.5, t0 + k * len * TM_MS_PER_MIN, t0 + (k + 1) * len * TM_MS_PER_MIN)

t_hm(int t) =>
    str.format_time(t, "HH:mm", CORE_TZ)

// Feeds a full Asia session (19:00–23:00) of `len`-minute candles on the given date.
// The high 105 is at 20:00, the low 96 at 21:30; every other candle is 100 / 99.
t_runAsia(SessionTracker s, int y, int mo, int d, int len, float hiVal) =>
    int t0 = timestamp(CORE_TZ, y, mo, d, 19, 0)
    int n = int(240 / len)
    int last = SES_NONE
    for k = 0 to n - 1
        int mins = k * len
        float h = mins == 60 ? hiVal : 100.0
        float l = mins == 150 ? 96.0 : 99.0
        last := s.update(t_sc(t0, k, len, h, l))
    last

if barstate.islast
    TestSuite s = st_new("SESSIONS")

    SessionTracker a1 = ses_new("ASIA", "Asia", 1140, 1380)
    int before = timestamp(CORE_TZ, 2026, 9, 21, 18, 55)
    a1.update(t_sc(before, 0, 5, 200.0, 0.0))
    int lastStatus = t_runAsia(a1, 2026, 9, 21, 5, 105.0)
    a1.update(t_sc(timestamp(CORE_TZ, 2026, 9, 21, 23, 0), 0, 5, 300.0, 1.0))
    s.check("SE-01", "Asia 5m: high / low / open / known at", "105 / 96 / 99.5 / 23:00", st_num(a1.lastHi) + " / " + st_num(a1.lastLo) + " / " + st_num(a1.lastOp) + " / " + t_hm(a1.lastKnownAt))
    s.check("SE-02", "18:55 and 23:00 candles are outside Asia (R1)", "high 105, low 96", "high " + st_num(a1.lastHi) + ", low " + st_num(a1.lastLo))
    s.check("SE-03", "Completes on the candle closing at 23:00", "COMPLETED", lastStatus == SES_COMPLETED ? "COMPLETED" : "not completed")
    s.check("SE-04", "Trading day of the 19:00 Asia session (C1)", "20260922", str.tostring(a1.lastDay))

    SessionTracker a2 = ses_new("ASIA", "Asia", 1140, 1380)
    t_runAsia(a2, 2026, 9, 21, 1, 105.0)
    s.check("SE-05", "Asia on 1m gives the same range as on 5m", "105 / 96 / 23:00", st_num(a2.lastHi) + " / " + st_num(a2.lastLo) + " / " + t_hm(a2.lastKnownAt))
    t_runAsia(a2, 2026, 9, 22, 1, 110.0)
    s.check("SE-06", "Next day's Asia replaces the most recent (D15.4)", "110 · 20260923", st_num(a2.lastHi) + " · " + str.tostring(a2.lastDay))

    SessionTracker l1 = ses_new("LONDON", "London", 60, 240)
    int lt0 = timestamp(CORE_TZ, 2026, 9, 22, 1, 0)
    for k = 0 to 179
        l1.update(t_sc(lt0, k, 1, k == 90 ? 104.0 : 100.0, k == 10 ? 97.0 : 99.0))
    s.check("SE-07", "London 1m 01:00–04:00: high / low / known at", "104 / 97 / 04:00", st_num(l1.lastHi) + " / " + st_num(l1.lastLo) + " / " + t_hm(l1.lastKnownAt))

    SessionTracker l2 = ses_new("LONDON", "London", 60, 240)
    for k = 0 to 30
        l2.update(t_sc(lt0, k, 5, 101.0, 99.0))
    bool stillOpen = l2.active
    l2.update(t_sc(timestamp(CORE_TZ, 2026, 9, 22, 5, 0), 0, 5, 150.0, 50.0))
    s.check("SE-08", "Missing end candle: completes on the next candle", "open, then known at 03:35", (stillOpen ? "open" : "closed") + ", then known at " + t_hm(l2.lastKnownAt))

    SessionTracker a3 = ses_new("ASIA", "Asia", 1140, 1380)
    int pt0 = timestamp(CORE_TZ, 2026, 9, 21, 20, 30)
    for k = 0 to 29
        a3.update(t_sc(pt0, k, 5, 100.0, 99.0))
    SessionTracker a4 = ses_new("ASIA", "Asia", 1140, 1380)
    t_runAsia(a4, 2026, 9, 21, 5, 105.0)
    s.check("SE-09", "Session first seen at 20:30 / from 19:00 is partial", "yes / no", st_yn(a3.lastPartial) + " / " + st_yn(a4.lastPartial))

    SessionTracker am = ses_new("NYAM", "NY AM", ses_hhmmToMin(830), ses_hhmmToMin(1100))
    array<string> amGot = array.new<string>()
    for hm in array.from(825, 830, 1055, 1100)
        amGot.push(st_yn(am.contains(t_sc(timestamp(CORE_TZ, 2026, 9, 22, int(math.floor(hm / 100.0)), hm % 100), 0, 5, 100.0, 99.0))))
    s.check("SE-10", "Tradeable (NY AM) 5m opens 08:25/08:30/10:55/11:00", "no,yes,yes,no", amGot.join(","))

    SessionTracker ny = ses_new("NY", "New York", 510, 900)
    SessionTracker pm = ses_new("NYPM", "NY PM", 750, 900)
    Candle c0900 = t_sc(timestamp(CORE_TZ, 2026, 9, 22, 9, 0), 0, 5, 100.0, 99.0)
    Candle c1230 = t_sc(timestamp(CORE_TZ, 2026, 9, 22, 12, 30), 0, 5, 100.0, 99.0)
    s.check("SE-11", "Overlaps: 09:00 in NY / NY AM; 12:30 in NY / NY PM", "yes,yes · yes,yes", st_yn(ny.contains(c0900)) + "," + st_yn(am.contains(c0900)) + " · " + st_yn(ny.contains(c1230)) + "," + st_yn(pm.contains(c1230)))

    int w = timestamp(CORE_TZ, 2027, 1, 11, 19, 0)
    SessionTracker a5 = ses_new("ASIA", "Asia", 1140, 1380)
    s.check("SE-12", "Winter: 19:00 Chicago is in Asia (in UTC)", "yes · 01:00", st_yn(a5.contains(t_sc(w, 0, 5, 100.0, 99.0))) + " · " + str.format_time(w, "HH:mm", "UTC"))

    s.check("SE-13", "HHMM settings: 1900 / 130 / 2300 in minutes", "1140 / 90 / 1380", str.tostring(ses_hhmmToMin(1900)) + " / " + str.tostring(ses_hhmmToMin(130)) + " / " + str.tostring(ses_hhmmToMin(2300)))

    s.render()

// Every indicator needs at least one output call; this hidden plot provides it.
plot(float(na), "Self-test", display = display.none)
